ErrorDocument 404 /404.html

RewriteEngine On

# ============================================================
# CARDÁPIOS - Redirect direto para PDFs (sem cache)
# ============================================================

# Rotas /cardapio/* e /cardapios/* -> redirect para PDF
RewriteRule ^cardapi?o/aguasclaras/?$ /cardapios/aguasclaras/cardapio-aguasclaras-2026-1.pdf [R=302,L]
RewriteRule ^cardapi?o/guara1/?$ /cardapios/guara1/cardapio-guara1-2026-1.pdf [R=302,L]
RewriteRule ^cardapi?o/guara2/?$ /cardapios/guara2/cardapio-guara2-2026-1.pdf [R=302,L]

# Acesso direto aos PDFs na pasta cardapios
RewriteRule ^cardapios/([^/]+)/([^/]+\.pdf)$ - [L]

# ============================================================
# ROTAS ANTIGAS - Redirect para página de atualização
# ============================================================
RewriteRule ^_files/ugd/74a360_52fa72b8e66f4732b2a5f6b6b44cf4ee\.pdf$ /cardapio-em-atualizacao.html [L,R=302]
RewriteRule ^aguas-claras$ /cardapio-em-atualizacao.html [L,R=302]
RewriteRule ^_files/ugd/novo_74a360_667e87410bba43ada073e24044858076\.pdf$ /cardapio-em-atualizacao.html [L,R=302]
RewriteRule ^guara1$ /cardapio-em-atualizacao.html [L,R=302]
RewriteRule ^guara2/cardapio-seu-juca-guara2\.pdf$ /cardapio-em-atualizacao.html [L,R=302]
RewriteRule ^guara2$ /cardapio-em-atualizacao.html [L,R=302]

# ============================================================
# HEADERS - No-cache para PDFs
# ============================================================
<FilesMatch "\.pdf$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# ============================================================
# SEGURANÇA - Desativar listagem de diretórios
# ============================================================
Options -Indexes
