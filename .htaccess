RewriteRule ^cardapio/guara2$ /cardapios/guara2/cardapio-guara2-2026-1.pdf [L]

RewriteRule ^aguasclaras$ https://seujucabsb.com.br/aguas-claras [L,R=302]
RewriteRule ^guara1$ https://seujucabsb.com.br/guara1 [L,R=302]
RewriteRule ^guara2$ https://www.seujucabsb.com.br/guara2/cardapio-seu-juca-guara2.pdf [L,R=302]
